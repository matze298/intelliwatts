{
  "name": "intelliwatts",
  "version": "1.0.0",
  "description": "IntelliWatts is a personal cycling coach that parses your training data from intervals.icu and generates a weekly training plan for you using an LLM of your choice.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:css": "./build_tailwind.sh",
    "build:tailwind-retro": "tailwindcss -i ./app/static/style-retro.css -o ./app/static/tailwind-retro.css --watch",
    "build:tailwind-minimal": "tailwindcss -i ./app/static/style-minimal.css -o ./app/static/tailwind-minimal.css --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@neon/config": "^1.9.6",
    "@neon/env": "^1.6.6"
  }
}
