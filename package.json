{
  "name": "intelliwatts",
  "version": "1.0.0",
  "description": "IntelliWatts is a personal cycling coach that parses your training data from intervals.icu and generates a weekly training plan for you using an LLM of your choice.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.4",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:css": "./build_tailwind.sh",
    "watch:css": "tailwindcss -i ./app/static/style-light.css -o ./app/static/tailwind-light.css --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@neon/config": "^1.11.3",
    "@neon/env": "^1.6.15"
